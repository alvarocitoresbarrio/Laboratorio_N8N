      "parameters": {
        "jsCode": "const productos = [\n  \"Sensor de movimiento\",\n  \"Cámara IP\",\n  \"Termostato inteligente\",\n  \"Detector de humo\"\n];\n\nconst clientes = [\n  { nombre: \"Juan García\", direccion: \"Calle Mayor 15, Burgos\" },\n  { nombre: \"Laura Martín\", direccion: \"Avenida del Cid 22, Burgos\" },\n  { nombre: \"Carlos Ruiz\", direccion: \"Calle Vitoria 8, Burgos\" },\n  { nombre: \"Marta López\", direccion: \"Plaza Mayor 3, Burgos\" }\n];\n\nconst comerciales = [\"Ana López\", \"Pedro Sánchez\", \"Lucía Fernández\"];\nconst producto = productos[Math.floor(Math.random() * productos.length)];\nconst cliente = clientes[Math.floor(Math.random() * clientes.length)];\nconst cantidad = Math.floor(Math.random() * 8) + 1;\nconst ahora = new Date();\n\nreturn [{\n  json: {\n    numero_pedido: `PED-${ahora.getTime()}`,\n    fecha: ahora.toISOString(),\n    comercial: comerciales[Math.floor(Math.random() * comerciales.length)],\n    cliente: cliente.nombre,\n    direccion: cliente.direccion,\n    producto,\n    cantidad,\n    estado_pedido: \"Nuevo\",\n    mensaje: \"Pedido generado automáticamente para simulación\"\n  }\n}];"
      },
